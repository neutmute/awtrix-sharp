@page "/ui/visuals"
@using AwtrixSharpWeb.Ui.Components
@using AwtrixSharpWeb.Ui.Models
@implements IDisposable
@inject IOptions<AwtrixConfig> Config
@inject IAwtrixService Awtrix
@inject PublishTrace Trace
@inject DeviceStateMonitor Monitor

<h1>Visuals</h1>

<div class="actions">
    <label>Device</label>
    <select class="device" @bind="_baseTopic">
        @foreach (var device in Config.Value.Devices)
        {
            <option value="@device.BaseTopic">@device.BaseTopic</option>
        }
    </select>
    @if (string.IsNullOrEmpty(_baseTopic))
    {
        <span class="muted no-devices">no devices configured</span>
    }
    <label><input type="radio" class="target-notify" name="target" checked="@(_form.Target == VisualsTarget.Notify)" @onchange="() => SetTarget(VisualsTarget.Notify)" /> Notify</label>
    <label><input type="radio" class="target-app" name="target" checked="@(_form.Target == VisualsTarget.CustomApp)" @onchange="() => SetTarget(VisualsTarget.CustomApp)" /> Custom app</label>
    @if (_form.Target == VisualsTarget.CustomApp)
    {
        <input class="app-name" @bind="_form.AppName" @bind:after="FormChanged" placeholder="app name" />
    }
    <span class="muted">Presets:</span>
    @foreach (var preset in VisualsPresets.All)
    {
        <button class="preset" @onclick="() => LoadPreset(preset)">@preset.Name</button>
    }
</div>

@{
    var caps = Monitor.Get(_baseTopic ?? string.Empty).Capabilities;
    var disabled = _manual;
}

<div class="two-col">
    <div>
        <p class="caps-source muted">@(caps.Source == CapabilitiesSource.Device ? "lists from device" : "built-in lists (no capabilities received)")</p>

        <fieldset disabled="@disabled">
            <legend>Text</legend>
            <div class="field"><label>Text</label><input class="text" disabled="@disabled" @bind="_form.Text" @bind:after="FormChanged" /></div>
            <div class="field"><label>Text colour</label><input class="text-color" disabled="@disabled" @bind="_form.TextColor" @bind:after="FormChanged" /></div>
            <div class="field"><label>Background</label><input class="background-color" disabled="@disabled" @bind="_form.BackgroundColor" @bind:after="FormChanged" placeholder="#RRGGBB or r,g,b" /></div>
            <div class="field"><label>Text case</label>
                <select disabled="@disabled" @bind="_form.TextCase" @bind:after="FormChanged">
                    @foreach (var v in Enum.GetValues<TextCase>()) { <option value="@v">@v</option> }
                </select></div>
            <div class="field"><label>Icon</label><input class="icon" disabled="@disabled" @bind="_form.Icon" @bind:after="FormChanged" /></div>
            <div class="field"><label>Icon mode</label>
                <select disabled="@disabled" @bind="_form.IconMode" @bind:after="FormChanged">
                    @foreach (var v in Enum.GetValues<IconMode>()) { <option value="@v">@v</option> }
                </select></div>
            <div class="field"><label>Font</label><ChoiceSelect Class="font" Options="NgVisuals.Fonts" Disabled="disabled" @bind-Value="_form.Font" @bind-Value:after="FormChanged" /></div>
        </fieldset>

        <fieldset disabled="@disabled">
            <legend>Effect</legend>
            <div class="field"><label>Effect</label><ChoiceSelect Class="effect" Options="caps.Effects" Disabled="disabled" @bind-Value="_form.Effect" @bind-Value:after="FormChanged" /></div>
            <div class="field"><label>Effect speed (@_form.EffectSpeed.ToString("0.0"))</label><input class="effect-speed" type="range" min="0.1" max="10" step="0.1" disabled="@disabled" @bind="_form.EffectSpeed" @bind:after="FormChanged" /></div>
            <div class="field"><label>Palette</label><ChoiceSelect Class="palette" Options="caps.Palettes" Disabled="disabled" @bind-Value="_form.Palette" @bind-Value:after="FormChanged" /></div>
            <div class="field"><label>Palette stops</label><input class="palette-stops" disabled="@disabled" @bind="_form.PaletteStops" @bind:after="FormChanged" placeholder="255,0,0;0,0,255 (overrides name)" /></div>
            <div class="field"><label>Palette blend</label><input type="checkbox" disabled="@disabled" @bind="_form.PaletteBlend" @bind:after="FormChanged" /></div>
            <div class="field"><label>Overlay</label><ChoiceSelect Class="overlay" Options="caps.Overlays" Disabled="disabled" @bind-Value="_form.Overlay" @bind-Value:after="FormChanged" /></div>
        </fieldset>

        <fieldset disabled="@disabled">
            <legend>Timing</legend>
            <div class="field"><label>Duration ms</label><input type="number" disabled="@disabled" @bind="_form.DurationMs" @bind:after="FormChanged" /></div>
            <div class="field"><label>Lifetime ms</label><input type="number" disabled="@disabled" @bind="_form.LifetimeMs" @bind:after="FormChanged" /></div>
            <div class="field"><label>Hold</label><input type="checkbox" disabled="@disabled" @bind="_form.Hold" @bind:after="FormChanged" /></div>
            <div class="field"><label>Blink ms</label><input type="number" disabled="@disabled" @bind="_form.TextBlinkMs" @bind:after="FormChanged" /></div>
            <div class="field"><label>Fade ms</label><input type="number" disabled="@disabled" @bind="_form.TextFadeMs" @bind:after="FormChanged" /></div>
        </fieldset>

        <fieldset disabled="@disabled">
            <legend>Scroll</legend>
            <div class="field"><label>Mode</label><ChoiceSelect Class="scroll-mode" Options="NgVisuals.ScrollModes" Disabled="disabled" @bind-Value="_form.ScrollMode" @bind-Value:after="FormChanged" /></div>
            <div class="field"><label>Speed px/s</label><input type="number" disabled="@disabled" @bind="_form.ScrollSpeed" @bind:after="FormChanged" /></div>
        </fieldset>

        @if (_form.Target == VisualsTarget.CustomApp)
        {
            <fieldset disabled="@disabled">
                <legend>Transition (custom app)</legend>
                <div class="field"><label>Effect</label><ChoiceSelect Class="transition" Options="caps.Transitions" Disabled="disabled" @bind-Value="_form.TransitionEffect" @bind-Value:after="FormChanged" /></div>
                <div class="field"><label>Direction</label><ChoiceSelect Class="transition-direction" Options="NgVisuals.TransitionDirections" Disabled="disabled" @bind-Value="_form.TransitionDirection" @bind-Value:after="FormChanged" /></div>
                <div class="field"><label>Duration ms</label><input type="number" disabled="@disabled" @bind="_form.TransitionDurationMs" @bind:after="FormChanged" /></div>
            </fieldset>
        }
    </div>

    <div>
        <div class="actions">
            <strong>@(_manual ? "JSON (manual)" : "JSON (from form)")</strong>
            @if (_manual)
            {
                <button class="back-to-form" @onclick="BackToForm">Back to form</button>
            }
        </div>
        <textarea class="json" value="@_json" @oninput="JsonEdited"></textarea>
        @foreach (var error in _errors)
        {
            <div class="error">@error</div>
        }
        <div class="actions">
            <button class="send" disabled="@(!CanSend)" @onclick="Send">Send</button>
            <button class="dismiss" disabled="@NoDevice" @onclick="Dismiss">Dismiss</button>
            @if (_form.Target == VisualsTarget.CustomApp)
            {
                <button class="clear-app" disabled="@NoDevice" @onclick="ClearApp">Clear this app</button>
            }
            @if (_sendResult != null)
            {
                <span class="send-result @(_sendResult.Value ? "result ok" : "result bad")">@(_sendResult.Value ? "delivered" : "not delivered (see logs)") @_sendAddress</span>
            }
        </div>

        @{
            var state = Monitor.Get(_baseTopic ?? string.Empty);
        }
        <details>
            <summary>Device state @(state.LastSeen.HasValue ? $"(received {state.LastSeen.Value.ToLocalTime():HH:mm:ss})" : "(nothing received)")</summary>
            <h2>settings</h2>
            <pre>@(DeviceSummary.Pretty(state.SettingsJson) is { Length: > 0 } s ? s : "none")</pre>
            <h2>device</h2>
            <pre>@(DeviceSummary.Pretty(state.DeviceJson) is { Length: > 0 } d ? d : "none")</pre>
        </details>
    </div>
</div>

@code {
    private readonly VisualsForm _form = new();
    private string? _baseTopic;
    private string _json = "";
    private bool _manual;
    private AwtrixAppMessage? _manualMessage;
    private string? _manualError;
    private List<string> _errors = new();
    private bool? _sendResult;
    private string? _sendAddress;

    private bool NoDevice => string.IsNullOrEmpty(_baseTopic);
    private bool CanSend => _errors.Count == 0 && (!_manual || _manualMessage != null) && !NoDevice;

    protected override void OnInitialized()
    {
        _baseTopic = Config.Value.Devices.FirstOrDefault()?.BaseTopic;
        Monitor.Changed += OnDeviceChanged;
        FormChanged();
    }

    private void SetTarget(VisualsTarget target)
    {
        _form.Target = target;
        FormChanged();
    }

    private void FormChanged()
    {
        if (_manual)
        {
            // Manual JSON mode: the textarea is the source of truth. Re-evaluate only the errors that
            // depend on the rest of the form (the custom-app name), never regenerate _json or discard
            // the already-parsed manual message.
            _errors = ManualErrors();
            return;
        }

        _errors = _form.Validate().ToList();
        _json = DeviceSummary.Pretty(_form.Build().ToJson());
    }

    private void JsonEdited(ChangeEventArgs e)
    {
        _manual = true;
        _json = e.Value?.ToString() ?? "";
        if (AwtrixAppMessage.TryFromJson(_json, out var message, out var error))
        {
            _manualMessage = message;
            _manualError = null;
        }
        else
        {
            _manualMessage = null;
            _manualError = error ?? "Invalid JSON";
        }
        _errors = ManualErrors();
    }

    /// <summary>
    /// Manual-mode errors: the JSON parse error (if any) plus the custom-app name check, which
    /// otherwise a manual JSON payload with an empty app name would skip entirely.
    /// </summary>
    private List<string> ManualErrors()
    {
        var errors = new List<string>();
        if (_manualError != null)
        {
            errors.Add(_manualError);
        }
        if (_form.Target == VisualsTarget.CustomApp && string.IsNullOrWhiteSpace(_form.AppName))
        {
            errors.Add("App name is required for a custom app");
        }
        return errors;
    }

    private void BackToForm()
    {
        _manual = false;
        _manualMessage = null;
        _manualError = null;
        FormChanged();
    }

    private void LoadPreset(VisualsPresets.Preset preset)
    {
        var target = _form.Target;
        var appName = _form.AppName;
        _form.Reset();
        _form.Target = target;
        _form.AppName = appName;
        preset.Apply(_form);
        BackToForm();
    }

    private AwtrixAddress Address => new() { BaseTopic = _baseTopic ?? string.Empty };

    private async Task Send()
    {
        var message = _manual ? _manualMessage : _form.Build();
        if (message == null)
        {
            return;
        }
        await Run(() => _form.Target == VisualsTarget.CustomApp ? Awtrix.AppUpdate(Address, _form.AppName, message) : Awtrix.Notify(Address, message));
    }

    private Task Dismiss() => Run(() => Awtrix.Dismiss(Address));

    private Task ClearApp() => Run(() => Awtrix.AppClear(Address, _form.AppName));

    private async Task Run(Func<Task<bool>> action)
    {
        try
        {
            _sendResult = await action();
            _sendAddress = Trace.Recent().FirstOrDefault()?.Request.Address;
        }
        catch (Exception ex)
        {
            _sendResult = false;
            _sendAddress = ex.Message;
        }
    }

    private void OnDeviceChanged(string baseTopic) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Monitor.Changed -= OnDeviceChanged;
}
