@inherits LayoutComponentBase
@inject IMqttConnector Mqtt

<header class="topbar">
    <span class="brand">AwtrixSharp</span>
    <nav>
        <NavLink href="ui" Match="NavLinkMatch.All">Apps</NavLink>
        <NavLink href="ui/visuals">Visuals</NavLink>
        <a href="swagger">Swagger</a>
    </nav>
    <span class="mqtt-state @(Mqtt.IsConnected ? "ok" : "bad")">MQTT: @(Mqtt.IsConnected ? "connected" : "disconnected")</span>
</header>
<main>
    @Body
</main>
