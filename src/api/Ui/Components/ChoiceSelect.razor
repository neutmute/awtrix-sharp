@* A dropdown over a vocabulary list with a blank "(none)" entry. A bound value that is not in the
   list (from a preset, a device swap or hand-edited JSON) is kept as an extra option so it is never
   silently replaced. *@
<select class="@Class" disabled="@Disabled" value="@Value" @onchange="OnChange">
    <option value="">(none)</option>
    @if (!string.IsNullOrEmpty(Value) && !Options.Contains(Value, StringComparer.OrdinalIgnoreCase))
    {
        <option value="@Value">@Value (not in list)</option>
    }
    @foreach (var option in Options)
    {
        <option value="@option">@option</option>
    }
</select>

@code {
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IReadOnlyList<string> Options { get; set; } = Array.Empty<string>();
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
